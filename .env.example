# ==============================================================================
# MetaTrader 5 Integration Service - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust the values according to your environment.

# ------------------------------------------------------------------------------
# Network & Server Settings
# ------------------------------------------------------------------------------
# Port on which the API server will listen (Default: 5000)
PORT=5000

# Host interface to bind to (Default: 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Shared secret access key required in the 'token' HTTP header for all requests.
# Generate a strong, random alphanumeric string for production use.
AUTH_TOKEN=your-secure-access-token-here

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Default: INFO)
LOG_LEVEL=INFO

# Directory where log files are stored (Default: logs)
LOG_DIR=logs

# ------------------------------------------------------------------------------
# Monitoring & Error Tracking (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for remote error reporting. Leave blank to disable.
SENTRY_DSN=
