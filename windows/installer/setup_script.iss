; windows/installer/setup_script.iss
; Inno Setup Script for MetaTrader 5 Integration Windows Server Installer

#define MyAppName "MetaTrader 5 Integration"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "FXBAX"
#define MyAppURL "https://github.com/fxbax/meta-trader-integration"
#define MyAppExeName "fxbax-mt.exe"

[Setup]
AppId={{D37F8E45-12B6-4A9A-B234-89C3DE819A2F}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\MetaTrader Integration
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputBaseFilename=Setup-MetaTrader-Integration-v{#MyAppVersion}
OutputDir=Output
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; Source files generated by PyInstaller --onedir build
Source: "..\..\dist\fxbax-mt\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\..\.env.example"; DestDir: "{app}"; Flags: ignoreversion

[Code]
var
  ConfigPage: TInputQueryWizardPage;
  PortEditIndex: Integer;
  TokenEditIndex: Integer;

procedure InitializeWizard;
begin
  // Create custom configuration wizard page
  ConfigPage := CreateInputQueryPage(
    wpSelectDir,
    'Service Configuration',
    'Configure API Network Port and Access Key',
    'Specify the TCP port and security access token for incoming API requests. You can change these later in the .env configuration file without rebuilding.'
  );

  PortEditIndex := ConfigPage.Add('HTTP API Port:', False);
  TokenEditIndex := ConfigPage.Add('Security Access Token (AUTH_TOKEN):', False);

  // Set default initial values
  ConfigPage.Values[PortEditIndex] := '5000';
  ConfigPage.Values[TokenEditIndex] := 'change-me-to-a-secure-token';
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  PortVal: Integer;
begin
  Result := True;
  if CurPageID = ConfigPage.ID then
  begin
    PortVal := StrToIntDef(ConfigPage.Values[PortEditIndex], 0);
    if (PortVal < 1) or (PortVal > 65535) then
    begin
      MsgBox('Please enter a valid port number between 1 and 65535.', mbError, MB_OK);
      Result := False;
      Exit;
    end;
    if Trim(ConfigPage.Values[TokenEditIndex]) = '' then
    begin
      MsgBox('Security Access Token cannot be blank.', mbError, MB_OK);
      Result := False;
      Exit;
    end;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  EnvFilePath: String;
  EnvContent: String;
  SelectedPort: String;
  SelectedToken: String;
  ResultCode: Integer;
begin
  if CurStep = ssPostInstall then
  begin
    SelectedPort := ConfigPage.Values[PortEditIndex];
    SelectedToken := ConfigPage.Values[TokenEditIndex];
    EnvFilePath := ExpandConstant('{app}\.env');

    // 1. Write user-configured .env file
    EnvContent := 'PORT=' + SelectedPort + #13#10 +
                  'HOST=0.0.0.0' + #13#10 +
                  'AUTH_TOKEN=' + SelectedToken + #13#10 +
                  'LOG_LEVEL=INFO' + #13#10 +
                  'LOG_DIR=' + ExpandConstant('{app}\logs') + #13#10;
    SaveStringToFile(EnvFilePath, EnvContent, False);

    // 2. Add inbound Windows Firewall rule
    Exec('netsh.exe', 'advfirewall firewall add rule name="MetaTrader Integration" dir=in action=allow protocol=TCP localport=' + SelectedPort, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);

    // 3. Register Windows Service
    Exec('sc.exe', 'create "MetaTraderIntegration" binPath= "\"' + ExpandConstant('{app}\fxbax-mt.exe') + '\"" start= auto DisplayName= "MetaTrader 5 Integration Service"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Exec('sc.exe', 'description "MetaTraderIntegration" "High-performance REST API gateway connecting external systems to MetaTrader 5."', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);

    // 4. Start the service
    Exec('sc.exe', 'start "MetaTraderIntegration"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  ResultCode: Integer;
begin
  if CurUninstallStep = usUninstall then
  begin
    // 1. Stop and remove Windows Service
    Exec('sc.exe', 'stop "MetaTraderIntegration"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Sleep(2000);
    Exec('sc.exe', 'delete "MetaTraderIntegration"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);

    // 2. Remove Windows Firewall rule
    Exec('netsh.exe', 'advfirewall firewall delete rule name="MetaTrader Integration"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  end;
end;
